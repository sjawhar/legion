+/**
+ * How deeply markdown blocks may nest, as the document service counts them, and micromark's `list`
+ * and `blockQuote` held to it.
+ *
+ * The service refuses a document that opens a block inside `maxBlockNesting` blocks, where a
+ * quote, a list, a list item, a typed block and a footnote definition each count one
+ * (`maxNesting`, packages/envoy/internal/dispatch/pmdoc/nesting.go). Micromark has no such bound:
+ * every open container runs its continuation on every line, so a body of D nested items and N
+ * lines costs D*N, and a chain of a few hundred openers also overflows the stack of the Milkdown
+ * parser and of prosemirror-model's `DOMSerializer`. An opener past the bound therefore does not
+ * open here either; it reads as the text it is, the way a `:::` opener past `maxDirectiveNesting`
+ * does (./directive-container.ts, INFRA-581). A body the service accepts nests within the bound,
+ * so no opener in one is ever refused and it reads exactly as before.
+ *
+ * A list opener opens a list *and* its first item, so it takes two of the service's levels; a
+ * later item of an open list stands where the first one did and takes none, as goldmark's list
+ * items carry no guard of their own (nesting.go:32-33). A quote opener takes one.
+ *
+ * The two constructs are rewritten in place rather than added as a micromark extension: an
+ * extension can add a construct for a character but not replace one, and turning the originals off
+ * by name (`disable`) also turns off the `effects.attempt(list, ...)` and
+ * `effects.attempt(blockQuote, ...)` each of them runs on itself to read a later item or a deeper
+ * `>` (micromark/lib/create-tokenizer.js:415 refuses any construct whose name is disabled,
+ * whoever passes it). Every markdown parse in this realm therefore reads the bound, which is what
+ * the service's parity needs: the live editor's Milkdown parser is built by
+ * `@milkdown/preset-commonmark` and never passes through this package's unified processors.
+ */
+
+import { blockQuote, list } from "micromark-core-commonmark";
+import { markdownLineEnding } from "micromark-util-character";
+
+import type {
+  Code,
+  Construct,
+  ContainerState,
+  Effects,
+  ParseContext,
+  State,
+  Token,
+  TokenizeContext,
+} from "micromark-util-types";
+
+declare module "micromark-util-types" {
+  interface Token {
+    /** How many blocks the service counts around this container's content. */
+    _nestDepth?: number;
+  }
+  interface ContainerState {
+    _nestDepth?: number;
+  }
+}
+
+/**
+ * How many blocks a document may open inside one another: `maxNesting` in
+ * packages/envoy/internal/dispatch/pmdoc/nesting.go. A quote, a list, a list item, a typed block
+ * and a footnote definition each count one.
+ */
+export const maxBlockNesting = 100;
+
+/** Per parse, the depth of the innermost container whose continuation passed `line`. */
+interface Continued {
+  line: number;
+  depth: number;
+}
+
+const continued = new WeakMap<ParseContext, Continued>();
+
+/**
+ * Records that a container whose content stands inside `depth` blocks went on at the current line.
+ * The document tokenizer runs continuations outermost first and stops at the first that fails, so
+ * the last one to record on a line is the innermost container still open around it; a continuation
+ * records only where it succeeded, so one that failed leaves the line at its parent's depth.
+ */
+export function recordContinued(context: TokenizeContext, depth: number): void {
+  let at = continued.get(context.parser);
+  if (at === undefined) {
+    at = { line: 0, depth: 0 };
+    continued.set(context.parser, at);
+  }
+  at.line = context.now().line;
+  at.depth = depth;
+}
+
+/**
+ * How many blocks stand around a container opening now: the one that opened before it on this
+ * line, or else the innermost one whose continuation passed the line.
+ */
+export function openAround(context: TokenizeContext): number {
+  const opened = openedOnLine(context);
+  if (opened !== undefined) return opened._nestDepth ?? 0;
+  const at = continued.get(context.parser);
+  return at !== undefined && at.line === context.now().line ? at.depth : 0;
+}
+
+/**
+ * The token of the innermost container that opened on the current line and has not closed, or
+ * undefined where none did. The walk stops at the flow chunk of the line before, so it reads only
+ * this line's events: the containers it opened, each stamped with its depth, and the exits of the
+ * ones it did not continue, which the document tokenizer appends before a container opens.
+ *
+ * A start reads the events rather than what the last start recorded because micromark runs the
+ * first start of a line twice, once inside the `check` of `checkNewContainers`, whose events it
+ * throws away, and once for real; both runs then read the same depth.
+ */
+function openedOnLine(context: TokenizeContext): Token | undefined {
+  const events = context.events;
+  let closed = 0;
+  for (let index = events.length - 1; index >= 0; index--) {
+    const [kind, token] = events[index];
+    if (kind === "exit" && token.type === "chunkFlow") return undefined;
+    if (token._container !== true) continue;
+    if (kind === "exit") closed++;
+    else if (closed > 0) closed--;
+    else return token;
+  }
+  return undefined;
+}
+
+type Tokenize = (this: TokenizeContext, effects: Effects, ok: State, nok: State) => State;
+
+/**
+ * Holds micromark's `list` and `blockQuote` to `maxBlockNesting`, and takes a blank line's list
+ * continuation without the `blankLine` check. Runs once; a second call does nothing.
+ *
+ * The fast path goes on first, so that `bound` wraps it and a blank line still records the depth
+ * its list went on at.
+ */
+export function boundBlockNesting(): void {
+  fastBlankLine(list);
+  bound(list, 2, (state) => state.type === undefined);
+  bound(blockQuote, 1, (state) => state.open !== true);
+}
+
+/** Whether `construct` already carries one of the rewrites below. */
+const rewritten = new WeakSet<object>();
+
+/**
+ * Rewrites `construct` so its start refuses an opener that would stand past the bound and stamps
+ * the container it opens with its depth, and its continuation records that depth for the line it
+ * went on at. `opens` is how many blocks the opener opens; `isFresh` says whether a start opens a
+ * container rather than reading a later part of an open one (a later item of a list, a deeper `>`
+ * of a quote), which the service never refuses.
+ */
+function bound(
+  construct: Construct,
+  opens: number,
+  isFresh: (state: ContainerState) => boolean
+): void {
+  if (rewritten.has(construct)) return;
+  rewritten.add(construct);
+  const start = construct.tokenize as Tokenize;
+  construct.tokenize = function (this: TokenizeContext, effects, ok, nok): State {
+    const self = this;
+    const state = self.containerState;
+    let depth = 0;
+    const inner = start.call(
+      self,
+      effects,
+      (code: Code) => {
+        if (depth > 0) {
+          const opened = openedOnLine(self);
+          if (opened !== undefined) opened._nestDepth = depth;
+        }
+        return ok(code);
+      },
+      nok
+    );
+    return (code: Code) => {
+      depth = 0;
+      if (isFresh(state)) {
+        depth = openAround(self) + opens;
+        if (depth > maxBlockNesting) return nok(code);
+        state._nestDepth = depth;
+      }
+      return inner(code);
+    };
+  };
+
+  const continuation = construct.continuation;
+  if (continuation === undefined) return;
+  const onLine = continuation.tokenize as Tokenize;
+  continuation.tokenize = function (this: TokenizeContext, effects, ok, nok): State {
+    const self = this;
+    const state = self.containerState;
+    return onLine.call(
+      self,
+      effects,
+      (code: Code) => {
+        if (state._nestDepth !== undefined) recordContinued(self, state._nestDepth);
+        return ok(code);
+      },
+      nok
+    );
+  };
+}
+
+/**
+ * Takes a blank line's list continuation without asking `blankLine` whether the line is blank.
+ *
+ * The continuation opens with `effects.check(blankLine, onBlank, notBlank)`
+ * (micromark-core-commonmark/lib/list.js), and `blankLine` only reads whether the rest of the line
+ * is whitespace. Where the line is already over - the code is a line ending or the end of the
+ * document - the answer is yes, and the check's store and restore, and the `blankLine` dispatch,
+ * are work for nothing. Every open list item runs that check once per blank line, so a body of D
+ * nested items and N blank lines runs D*N of them; on a body of 50 nested items and 32 KB of blank
+ * lines it is about two fifths of what micromark spends.
+ *
+ * `onBlank` then runs `factorySpace(effects, ok, "listItemIndent", size + 1)`, which consumes
+ * nothing where the code is a line ending, so this leaves the state the original leaves:
+ * `furtherBlankLines` set from `initialBlankLine`, `_closeFlow` cleared.
+ */
+function fastBlankLine(construct: Construct): void {
+  const continuation = construct.continuation;
+  if (continuation === undefined || rewritten.has(continuation)) return;
+  rewritten.add(continuation);
+  const onLine = continuation.tokenize as Tokenize;
+  continuation.tokenize = function (this: TokenizeContext, effects, ok, nok): State {
+    const self = this;
+    let slow: State | undefined;
+    return (code: Code) => {
+      const state = self.containerState;
+      if (code === null || markdownLineEnding(code)) {
+        state._closeFlow = undefined;
+        state.furtherBlankLines = state.furtherBlankLines || state.initialBlankLine;
+        return ok(code);
+      }
+      slow ??= onLine.call(self, effects, ok, nok);
+      return slow(code);
+    };
+  };
+}
