+// linkCount counts the links a parse has appended, which a link label reads when it opens and
+// again when it closes (linkLabelState.linksBefore).
+var linkCount = NewContextKey()
+
+// LinkCount is how many links the parse has appended so far. The inline parser counts one for
+// every *ast.Link any parser gives it (CountLink), core's and an extension's alike.
+func LinkCount(pc Context) int {
+	count, _ := pc.Get(linkCount).(int)
+	return count
+}
+
+// CountLink records one more appended link (LinkCount). The inline parser calls it; a parser that
+// builds a link into a node of its own, rather than returning the link itself, calls it too, or a
+// label holding that link is read as link text it may not hold.
+func CountLink(pc Context) {
+	pc.Set(linkCount, LinkCount(pc)+1)
+}
