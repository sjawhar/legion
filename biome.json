{
  "$schema": "https://biomejs.dev/schemas/2.4.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!!packages/contracts/fixtures/classification",
      "!!packages/contracts/fixtures/daemon-api",
      "!!packages/contracts/fixtures/delivery-live",
      "!!packages/daemon/internal/runtime/sandbox/testdata/golden",
      "!!packages/envoy/internal/dispatch/pmdoc/testdata",
      "!!packages/envoy/internal/dispatch/text/testdata",
      "!!packages/daemon/docker/language-servers/package-lock.json",
      "!!.legion"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf",
    "includes": ["**", "!packages/envoy-client/src/__tests__/fixtures/dispatch-tool.schema.json"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noImportCycles": "error"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/proof-editor/src/**",
        "!packages/proof-editor/src/tests/harness.ts",
        "!packages/proof-editor/src/collab-cursor-plugin.ts",
        "!packages/proof-editor/src/editor-highlights.ts",
        "!packages/proof-editor/src/editor/schema/uuid.ts",
        "!packages/proof-editor/src/trailing-newline-input.ts",
        "!packages/proof-editor/src/record-mark-history.ts",
        "!packages/proof-editor/src/record-mark-retype.ts",
        "!packages/proof-editor/src/record-mark-target.ts",
        "packages/proof-editor/upstream/**"
      ],
      "assist": { "enabled": false },
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    },
    {
      "includes": ["packages/dispatch/web/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@legion/contracts": {
                    "importNames": ["actorLabel", "actorName", "sessionLabel", "shortSessionId"],
                    "message": "An agent is shown only through features/refs/AgentName.tsx (AgentName, or useAgentText for an attribute or other plain string)."
                  }
                },
                "patterns": [
                  {
                    "group": ["**/refs/routes", "./routes"],
                    "importNamePattern": "AGENT_LIVE_PATH",
                    "message": "A link to an agent's live conversation is AgentName's (features/refs/AgentName.tsx)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/dispatch/web/src/app.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@legion/contracts": {
                    "importNames": ["actorLabel", "actorName", "sessionLabel", "shortSessionId"],
                    "message": "An agent is shown only through features/refs/AgentName.tsx (AgentName, or useAgentText for an attribute or other plain string)."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/dispatch/web/src/features/refs/AgentName.tsx",
        "packages/dispatch/web/src/features/refs/routes.ts"
      ],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ]
}
