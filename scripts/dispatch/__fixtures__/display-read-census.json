    {
      "id": "a-heading-and-a-paragraph",
      "group": "comment",
      "markdown": "# Title\n\nA paragraph with *emphasis*.\n",
      "from": "the readers",
      "why": "ordinary markdown: both readers read the same tree",
      "go": {
        "type": "doc",
        "content": [
          {
            "type": "heading",
            "attrs": {
              "id": "",
              "level": 1
            },
            "content": [
              {
                "type": "text",
                "text": "Title"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "A paragraph with "
              },
              {
                "type": "text",
                "text": "emphasis",
                "marks": [
                  {
                    "type": "emphasis",
                    "attrs": {
                      "marker": "*"
                    }
                  }
                ]
              },
              {
                "type": "text",
                "text": "."
              }
            ]
          }
        ]
      },
      "browser": {
        "type": "doc",
        "content": [
          {
            "type": "heading",
            "attrs": {
              "id": "",
              "level": 1,
              "blockId": "b-000001"
            },
            "content": [
              {
                "type": "text",
                "text": "Title"
              }
            ]
          },
          {
            "type": "paragraph",
            "attrs": {
              "blockId": "b-000002"
            },
            "content": [
              {
                "type": "text",
                "text": "A paragraph with "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "emphasis",
                    "attrs": {
                      "marker": "*"
                    }
                  }
                ],
                "text": "emphasis"
              },
              {
                "type": "text",
                "text": "."
              }
            ]
          }
        ]
      },
      "class": "the two agree"
    },
