      "browser": null,
      "browserError": "MilkdownError: [Description]: \"Cannot create node for doc\".\n[Attributes]: null.\n[Content]: [\"html\"].",
      "class": "the browser cannot read it"
    },
    {
      "id": "an-ask-attribute-holding-an-escaped-quote",
      "group": "comment",
      "markdown": ":::ask{answer=\"\\\"A\\\"\"}\nq\n:::\n",
      "from": "the readers",
      "why": "Go reads the block and shows its body alone; the browser's tokenizer refuses the opener and shows the whole fence line, the recorded answer with it",
      "go": {
        "type": "doc",
        "content": [
          {
            "type": "ask",
            "attrs": {
              "multiple": false,
              "state": "open",
              "urgency": "med"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "q"
                  }
                ]
              }
            ]
          }
        ]
      },
      "browser": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "attrs": {
              "blockId": "b-000001"
            },
            "content": [
              {
                "type": "text",
                "text": ":::ask{answer=\"\"A\"\"} q :::"
              }
            ]
          }
        ]
      },
      "class": "Go loses text"
    },
    {
      "id": "a-text-holding-a-nul",
      "group": "comment",
      "markdown": "a\u0000b\n",
      "from": "the readers",
      "why": "Go keeps U+0000 and the engine replaces it with U+FFFD, so each holds a character the other does not",
      "go": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "a\u0000b"
              }
            ]
          }
        ]
      },
      "browser": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "attrs": {
              "blockId": "b-000001"
            },
            "content": [
              {
                "type": "text",
                "text": "a�b"
              }
            ]
          }
        ]
      },
      "class": "the text differs both ways"
    },
