# Copy to compose/.env (git-ignored). Docker Compose reads it on every `docker compose` run from
# this directory, so the machine's settings live here, not in a shell session.

# The published image to run: `latest` is main's newest published build, and a full commit sha of
# main pins one. A tag that was never published is refused when the image is pulled.
ENVOY_IMAGE_TAG=latest

# This machine's name, as `hostname -s` prints it: sessions report that name as their machine. It
# also names the listener's durable NATS consumer (listener-<id>), which NATS refuses when the name
# holds a `.`; the listener then exits and restarts over and over. Empty refuses to start.
ENVOY_MACHINE_ID=

# Ports, all on 127.0.0.1. Change one only when something else on the machine already uses it,
# and change the session config file to match (envoy.url, envoy.natsUrls).
#ENVOY_LISTENER_PORT=9020
#NATS_PORT=4222
#NATS_MONITOR_PORT=8222

# Optional bearer token for the listener's /v1 API (`openssl rand -hex 32`); when set, put the same
# value in envoy.token. It does not cover NATS, which takes no credential, so every user on this
# machine can still read and send messages through 127.0.0.1:4222.
#ENVOY_API_TOKEN=
