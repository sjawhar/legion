# legion controller start --config controller.yaml [--daemon-url http://127.0.0.1:13370]
# The operator-side file: the same key names as legion.yaml, only the twelve keys the controller
# needs; any other key is refused naming it. Relative paths resolve against this file's directory
# (no ~ expansion).
# The daemon's project, exactly as its legion.yaml writes it: `sjawhar/legion` and `sjawharlegion`
# both name the same instance — the value is sanitized like the daemon's (lowercased, every
# non-alphanumeric dropped) before it names the controller token and LEGION_PROJECT.
project: demo
# The daemon's API. From another machine, reach it through a port-forward or a tunnel, then either
# set this to the forwarded address or pass --daemon-url.
daemon_url: http://127.0.0.1:13370
# The daemon's operator token (the value its own operator_token_file holds), in a file only you can
# read (chmod 0600); a group- or world-readable file is refused before anything is fetched.
operator_token_file: ./operator-token
# The Envoy listener and NATS the controller talks to, and the listener's bearer (the providers
# Secret's ENVOY_TOKEN). envoy_token_file is optional for a loopback dev listener.
envoy_url: http://envoy-listener.example:9020
envoy_token_file: ./envoy-token
nats_urls:
  - nats://nats.example:4222
# Dispatch, for the controller's native tools (both keys or neither).
dispatch_url: https://dispatch.example
dispatch_token_file: ./dispatch-token
# The deployment's standing rules, appended to the controller's system prompt like every pane's.
instructions: ./instructions.md
# How Oh My Pi is launched on this machine (defaults: no prefix; the TypeScript CLI's invocation is the
# daemon's pinned `mise x … -- omp`, while the Go CLI holds no pin — set omp_invocation, or set
# LEGION_OMP_PATH to an absolute omp, and it resolves the invocation as the Go daemon does).
# omp_invocation: mise x github:sjawhar/oh-my-pi@<version> -- omp
# The Go `legion controller start` runs the prefix twice: once to probe the plugin Oh My Pi loads,
# before it asks the daemon for a capability, and once to launch. Both run at your terminal, as its
# foreground job, so a prefix that asks for a PIN or a touch asks there, each time: `secrets` asks
# once and the launch reuses its terminal-scoped grant. The prefix must run its command in that
# same job: one that gives it a foreground process group of its own (`sudo` under `use_pty`,
# anything with job control) takes a Ctrl-C during the probe away from legion, and the probe then
# passes on a Ctrl-C it should refuse. `secrets` execs its command, which is fine.
# omp_launch_prefix: [secrets, ANTHROPIC_API_KEY, GEMINI_API_KEY, OPENAI_API_KEY, --]
# Where the controller's secret, gh shim, legion launcher, and instructions live
# (default: $XDG_STATE_HOME/legion/<project>-controller, i.e. ~/.local/state/legion/demo-controller).
# state_dir: ./state
