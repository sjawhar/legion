# cp operator.env.example operator.env and set one long random string, e.g. `openssl rand -hex 32`;
# operator.env is gitignored. The same value goes into the 0600 file on the operator's machine that
# controller.yaml's operator_token_file names (deploy/kubernetes/daemon/controller.yaml.example):
# `legion controller start` presents it to POST /legion/v1/controller/secret.
OPERATOR_TOKEN=replace-me
