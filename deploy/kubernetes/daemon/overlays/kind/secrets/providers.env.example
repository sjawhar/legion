# cp providers.env.example providers.env and fill every value; providers.env is gitignored.
# One key per variable OMP or the extension reads in a worker pod (docs/kubernetes.md, "The
# providers Secret") plus the two the daemon itself reads: DISPATCH_TOKEN (its environment) and
# ENVOY_TOKEN (envoy_token_file) — the value the Envoy listener runs with as ENVOY_API_TOKEN.
DISPATCH_TOKEN=
ENVOY_TOKEN=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
