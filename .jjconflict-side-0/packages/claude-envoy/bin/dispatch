#!/bin/sh
# The dispatch CLI, bundled into this plugin's dist/ by its build.
here=$(cd "$(dirname "$0")" && pwd)
cli="$here/../dist/dispatch.js"
[ -f "$cli" ] || { echo "dispatch: $cli is missing; main's rebuild workflow commits it, or build a copy with bun scripts/build.ts --out <dir>" >&2; exit 2; }
exec bun "$cli" "$@"
