#!/usr/bin/env python3
"""Which model answered the CI review, and whether it is the model the review asked for, at Anthropic's API.

  served asked anthropic/<model>
  served run <directory> anthropic/<model> -- <Claude Code's command...>
  served check < <directory>/served

asked exits 0 when run can check anthropic/<model>, and 2, saying why, when it cannot.

run refuses to start Claude Code (exit 4, the reason on standard error) when its environment, or the `env` of
~/.claude/settings.json, ./.claude/settings.json or ./.claude/settings.local.json, could send its requests elsewhere
than https://api.anthropic.com: an ANTHROPIC_BASE_URL of another value, an ANTHROPIC_* or CLAUDE_CODE_* variable not in
ALLOWED, a proxy variable in any case, or a variable that changes which TLS certificates are trusted. Otherwise it runs
the command, whose standard output is Claude Code's event stream (--output-format stream-json --verbose), and writes
into <directory>:
  claude.jsonl  the stream, line by line
  claude.json   the stream's last `result` event; empty when there is none
  served        `asked <provider>/<model>`, `endpoint <host>`, then one `<provider>/<model> <turns>` line per model that
                answered, a turn being one assistant message id (an event marked is_api_error_message is no turn)
It stops Claude Code at the first assistant event whose model is neither the model asked for nor a dated snapshot of it
(<model>-YYYYMMDD), and exits with Claude Code's status, or 4 when it stopped it.

check reads a record and prints one line: exit 0 and `firstParty/<model> (<n> turns)` when only the model asked for
answered, at api.anthropic.com; 1, with why, when another endpoint or model answered; 3 when the record shows neither.
"""
import json
import os
import re
import subprocess
import sys

HOST = "api.anthropic.com"
BASE_URL = "https://" + HOST
STOPPED, UNATTRIBUTED = 4, 3
# The credentials and federation names, and knobs that move no request and pick no model.
ALLOWED = {"ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_IDENTITY_TOKEN", "ANTHROPIC_IDENTITY_TOKEN_FILE",
           "ANTHROPIC_FEDERATION_RULE_ID", "ANTHROPIC_ORGANIZATION_ID", "ANTHROPIC_SERVICE_ACCOUNT_ID",
           "ANTHROPIC_WORKSPACE_ID", "ANTHROPIC_SCOPE", "ANTHROPIC_BASE_URL", "CLAUDE_CODE_OAUTH_TOKEN",
           "CLAUDE_CODE_ENABLE_TELEMETRY", "CLAUDE_CODE_MAX_OUTPUT_TOKENS"}
PREFIXES = ("ANTHROPIC_", "CLAUDE_CODE_", "_CLAUDE_CODE_")
PROXIES = {"HTTPS_PROXY", "HTTP_PROXY", "ALL_PROXY"}
TLS = {"NODE_TLS_REJECT_UNAUTHORIZED", "NODE_EXTRA_CA_CERTS", "SSL_CERT_FILE", "SSL_CERT_DIR"}
NAME = re.compile(r"[A-Za-z0-9._:@+-]{1,100}")


def asked_for(asked):
    provider, _, model = asked.partition("/")
    if provider != "anthropic" or not NAME.fullmatch(model):
        raise ValueError(f"cannot check {asked!r}: only anthropic/<model> is checked")
    return model


def refusal(name, value, where):
    """Why the variable `name`, set in `where`, would let another party answer; None when it would not."""
    if name.upper() in PROXIES or name in TLS:
        return f"{where} sets {name}"
    if name == "ANTHROPIC_BASE_URL" and str(value).rstrip("/") != BASE_URL:
        return f"{where} sets ANTHROPIC_BASE_URL to another endpoint"
    if name.startswith(PREFIXES) and name not in ALLOWED:
        return f"{where} sets {name}, which is not on the allow list"
    return None


def refusals(environment):
    found = [refusal(k, v, "the environment") for k, v in environment.items()]
    home = environment.get("HOME", os.path.expanduser("~"))
    for path in (os.path.join(home, ".claude/settings.json"), ".claude/settings.json", ".claude/settings.local.json"):
        try:
            with open(path) as f:
                env = json.load(f).get("env") or {}
        except FileNotFoundError:
            continue
        except (OSError, ValueError, AttributeError) as e:
            found.append(f"{path} cannot be read ({type(e).__name__})")
            continue
        if not isinstance(env, dict):
            found.append(f"{path} has an env that is not an object")
            continue
        found += [refusal(k, v, path) for k, v in env.items()]
    return [why for why in found if why]


def same_model(answered, model):
    return answered == model or re.fullmatch(re.escape(model) + r"-\d{8}", answered or "") is not None


def run(directory, asked, command):
    model = asked_for(asked)
    turns, order, stopped, result = {}, [], None, None
    with open(os.path.join(directory, "served"), "w") as record:
        record.write(f"asked {asked}\nendpoint {HOST}\n")
    why = refusals(dict(os.environ))
    if why:
        print("served: Claude Code is not started: " + "; ".join(why), file=sys.stderr)
        return STOPPED
    child = subprocess.Popen(command, stdout=subprocess.PIPE)
    with open(os.path.join(directory, "claude.jsonl"), "wb") as stream:
        for raw in child.stdout:
            stream.write(raw)
            stream.flush()
            try:
                event = json.loads(raw)
            except ValueError:
                continue
            if not isinstance(event, dict):
                continue
            if event.get("type") == "result":
                result = raw
            if event.get("type") != "assistant" or event.get("is_api_error_message") is True:
                continue
            message = event.get("message") or {}
            answered = message.get("model") if isinstance(message.get("model"), str) else "none"
            answered = answered if NAME.fullmatch(answered) else "none"
            turns.setdefault(answered, set()).add(str(message.get("id")))
            if answered not in order:
                order.append(answered)
            if not same_model(answered, model):
                stopped = f"{answered} answered, not {model}: Claude Code is stopped"
                child.terminate()
                break
    try:
        status = child.wait(timeout=30)
    except subprocess.TimeoutExpired:
        child.kill()
        status = child.wait()
    with open(os.path.join(directory, "claude.json"), "wb") as f:
        f.write(result or b"")
    with open(os.path.join(directory, "served"), "a") as record:
        for answered in order:
            record.write(f"anthropic/{answered} {len(turns[answered])}\n")
    if stopped:
        print(f"served: {stopped}", file=sys.stderr)
        return STOPPED
    return status if status >= 0 else 128 - status


def check(text):
    asked, endpoint, answered = None, None, []
    for line in text.splitlines():
        word, _, rest = line.partition(" ")
        if word == "asked":
            asked = rest
        elif word == "endpoint":
            endpoint = rest
        elif word.startswith("anthropic/") and rest.isdigit():
            answered.append((word.partition("/")[2], int(rest)))
        elif line.strip():
            return UNATTRIBUTED, "the record has a line it cannot read: it is not attributable"
    try:
        model = asked_for(asked or "")
    except ValueError:
        return UNATTRIBUTED, "the record names no model asked for: it is not attributable"
    if endpoint is None:
        return UNATTRIBUTED, "the record names no endpoint: it is not attributable"
    if endpoint != HOST:
        return 1, f"the requests went to {endpoint}, not {HOST}"
    others = [f"{m} ({n} turns)" for m, n in answered if not same_model(m, model)]
    if others:
        return 1, f"another model answered: {', '.join(others)}"
    total = sum(n for _, n in answered)
    if total == 0:
        return UNATTRIBUTED, "no turn is recorded: it is not attributable"
    return 0, f"firstParty/{model} ({total} turns)"


def main(argv):
    if argv == ["check"]:
        code, line = check(sys.stdin.read())
        print(line)
        return code
    if len(argv) == 2 and argv[0] == "asked" or len(argv) > 4 and argv[0] == "run" and argv[3] == "--":
        try:
            asked_for(argv[1] if argv[0] == "asked" else argv[2])
        except ValueError as e:
            print(f"served: {e}", file=sys.stderr)
            return 2
        return 0 if argv[0] == "asked" else run(argv[1], argv[2], argv[4:])
    print("usage: served asked anthropic/<model> | run <directory> anthropic/<model> -- <command...> | "
          "check < <record>", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
