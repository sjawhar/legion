    "@milkdown/plugin-clipboard@7.22.1": "patches/@milkdown%2Fplugin-clipboard@7.22.1.patch",
    "prosemirror-tables@1.8.5": "patches/prosemirror-tables@1.8.5.patch",
    "nats@2.29.3": "patches/nats@2.29.3.patch",
    "micromark@4.0.2": "patches/micromark@4.0.2.patch",
    "micromark-core-commonmark@2.0.3": "patches/micromark-core-commonmark@2.0.3.patch",
