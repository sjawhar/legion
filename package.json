  "dependencies": {
    "@toon-format/toon": "^4.1.1",
    "nats": "^2.29.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "latest",
    "@types/spdx-expression-parse": "3.0.0",
