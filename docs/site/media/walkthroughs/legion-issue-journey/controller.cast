[8.285108, "o", "\u001b[?25l\u001b[H\u001b[K\u001b[38;5;137m\r\n  ⎋\u001b[39m \u001b[38;5;243mWo\u001b[m\u000f\u001b[38;5;208mrk\u001b[1ming…\u001b[m\u000f                                                                \u001b[2m\u001b[3mLegion controller · SHOP\u001b[m\u000f\u001b[48;5;233m\u001b[3;1H \u001b[38;5;243m⠦ 0s\u001b[39m \u001b[38;5;236m>\u001b[39m \u001b[38;5;208m⬢ example-model\u001b[39m \u001b[38;5;236m>\u001b[39m \u001b[38;5;255m🗑 …S/home/shop/controller-state/controller\u001b[39m \u001b[49m\u001b[38;5;233m▶\u001b[m\u000f\u001b[38;5;208m────15%\u001b[m\u000f\u001b[38;5;236m────────────\u001b[m\u000f\u001b[38;5;248m╎\u001b[m\u000f\u001b[38;5;236m─\u001b[m\u000f\u001b[38;5;137m┃\u001b[m\u000f\u001b[38;5;236m───\u001b[m\u000f\u001b[38;5;137m128K\u001b[m\u000f\u001b[38;5;236m─\u001b[39m\u001b[38;5;208m\u001b[4;1H╰─\u001b[39m\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[34h\u001b[?25h\u001b[4;4H"]
