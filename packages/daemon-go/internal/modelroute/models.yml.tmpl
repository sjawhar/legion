# Written by the Go `legion` (packages/daemon-go/internal/modelroute) when Oh My Pi starts in a Legion
# pod, from the pod's LEGION_MODEL_GATEWAY_URL: Oh My Pi reads a baseUrl literally, so the gateway the
# daemon names is written out here at start rather than carried in the image.
#
# anthropic is routed to the model gateway (middleman) and keyed by the pod's projected ServiceAccount
# token. The gateway reads the key from x-api-key; Oh My Pi caches the command's value for the process
# and runs it again on a 401, so the token the kubelet rotated is read on the first refusal.
# `auth: apiKey` makes these custom models plain API-key callers: without it Oh My Pi sends an
# anthropic-messages custom model in its Claude Code OAuth shape (a billing header in the system
# prompt, a claude-cli user agent, the oauth beta).
#
# The models are the gateway's `-legion` aliases (agent-c's LEGION_MODEL_ALIAS_NAMES), the only
# names the gateway serves a Legion pod's token. Oh My Pi finds no catalog entry for an aliased id,
# so each carries its model's catalog metadata (Oh My Pi's bundled catalog at the pinned fork).
providers:
  anthropic:
    baseUrl: {{yaml .BaseURL}}
    auth: apiKey
    api: anthropic-messages
    apiKey: {{yaml .KeyCommand}}
    headers:
      X-Api-Key: {{yaml .KeyCommand}}
    models:
      - id: claude-fable-5-1-legion
        name: Claude Fable 5.1 (Legion gateway)
        reasoning: true
        input: [text, image]
        contextWindow: 1000000
        maxTokens: 128000
        cost: {input: 10, output: 50, cacheRead: 0.25, cacheWrite: 12.5}
      - id: claude-fable-5-legion
        name: Claude Fable 5 (Legion gateway)
        reasoning: true
        input: [text, image]
        contextWindow: 1000000
        maxTokens: 128000
        cost: {input: 10, output: 50, cacheRead: 1, cacheWrite: 12.5}
      - id: claude-opus-5-legion
        name: Claude Opus 5 (Legion gateway)
        reasoning: true
        input: [text, image]
        contextWindow: 1000000
        maxTokens: 128000
        cost: {input: 5, output: 25, cacheRead: 0.5, cacheWrite: 6.25}
      - id: claude-opus-4-8-legion
        name: Claude Opus 4.8 (Legion gateway)
        reasoning: true
        input: [text, image]
        contextWindow: 1000000
        maxTokens: 128000
        cost: {input: 5, output: 25, cacheRead: 0.5, cacheWrite: 6.25}
      - id: claude-sonnet-5-legion
        name: Claude Sonnet 5 (Legion gateway)
        reasoning: true
        input: [text, image]
        contextWindow: 1000000
        maxTokens: 128000
        cost: {input: 3, output: 15, cacheRead: 0.3, cacheWrite: 3.75}
