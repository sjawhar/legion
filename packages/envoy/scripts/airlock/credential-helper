#!/bin/sh
# Check k7's git credential helper: it answers the placeholder GITHUB_ADMIN_PAT holds, so the
# push git makes carries what the airlock swaps a real value into and nothing else. The pod's
# own GIT_CONFIG_* settings name a helper of their own, which the step clears for this one.
[ "$1" = get ] || exit 0
printf 'username=x\npassword=%s\n' "$GITHUB_ADMIN_PAT"
