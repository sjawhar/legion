# Copy to compose/.env (git-ignored). Docker Compose reads it on every
# `docker compose` run from this directory, so the host's Dispatch settings belong there — not
# in a shell session. Exported variables override it.

# Image built by ../docker/Dockerfile; scripts/up-dispatch.sh builds it locally
# as `local`. Hosts that only receive deploy/ set a published tag and pull.
ENVOY_IMAGE_TAG=local

# Where browsers reach Dispatch. Use the host's Tailscale IPv4 address
# (`tailscale ip -4`) for tailnet access; 127.0.0.1 for a local-only server.
# Never 0.0.0.0.
DISPATCH_LISTEN_HOST=127.0.0.1
DISPATCH_PORT=8766
# The browser origin and sign-in callback origin. It must match the URL
# humans type into their browser.
DISPATCH_SERVER_URL=http://example-host-devbox:8766
# Dispatch publishes native issue events through this NATS cluster.
NATS_URLS=nats://envoy-nats:4222
# Browsers use http:// on the tailnet, so the session cookie cannot be Secure.
DISPATCH_INSECURE_COOKIE=1

# Envoy listener the dashboard reads live agent titles from (cmd/listener, same host).
ENVOY_URL=http://127.0.0.1:9020

# The external Dispatch Postgres URL (in production, the deployment's own managed database, whose
# URL it reads from its own secret store). This compose runs no Postgres of its own; the production
# deployment's own scheduled backup task owns the dumps.
DATABASE_URL=postgres://dispatch:change-me@change-me:5432/dispatch?sslmode=require
# Secret — generate with `openssl rand -hex 32`.
DISPATCH_AGENT_TOKEN=change-me

# Google sign-in through the shared sign-in pool: its issuer, Dispatch's app client and secret, and
# the group a person must be in. Cookie identity requires all four.
DISPATCH_SIGNIN_ISSUER=
DISPATCH_SIGNIN_CLIENT_ID=
DISPATCH_SIGNIN_CLIENT_SECRET=
DISPATCH_SIGNIN_GROUP=
# The GitHub App Dispatch reads GitHub as; its private key is the `pem` in the data volume's app.json.
DISPATCH_APP_CLIENT_ID=

# Native Dispatch project for external owner/repo#n issues. Settings in the
# dashboard are authoritative. DISPATCH_REPO_PROJECTS optionally seeds missing
# mappings at boot (owner/repo=KEY,...), without overwriting dashboard settings.
# Repositories without a mapping fall through to DISPATCH_DEFAULT_PROJECT; omit
# it only when every external repository has a stored mapping.
DISPATCH_DEFAULT_PROJECT=
DISPATCH_REPO_PROJECTS=

