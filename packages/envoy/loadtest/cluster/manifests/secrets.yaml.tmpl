# secrets.yaml.tmpl: the run's credentials, every one random and written from scratch by
# cluster.sh up (never a production credential, per "Running a copy"), kept in the run's
# state.json (mode 600) on the worker pod. cluster.sh fills every placeholder (each credential
# with a lowercase hex value) and applies the result from stdin; the rendered file is never
# written to disk.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/part-of: dispatch-loadtest
    dispatch-loadtest/run: __RUN_ID__
type: Opaque
stringData:
  password: __PG_PASSWORD__
---
apiVersion: v1
kind: Secret
metadata:
  name: dispatch-credentials
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/part-of: dispatch-loadtest
    dispatch-loadtest/run: __RUN_ID__
type: Opaque
stringData:
  DATABASE_URL: postgres://dispatch:__PG_PASSWORD__@postgres.__NAMESPACE__.svc:5432/dispatch?sslmode=disable
  DISPATCH_AGENT_TOKEN: __DISPATCH_TOKEN__
  DISPATCH_SIGNING_KEY: __SIGNING_KEY__
---
apiVersion: v1
kind: Secret
metadata:
  name: listener-credentials
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/part-of: dispatch-loadtest
    dispatch-loadtest/run: __RUN_ID__
type: Opaque
stringData:
  ENVOY_API_TOKEN: __LISTENER_TOKEN__
