{
  "metadata": {
    "annotations": {
      "checksum/example-dispatch-dispatch": "example-dispatch-dispatch-resource-version",
      "checksum/example-dispatch-listener": "example-dispatch-listener-resource-version",
      "cluster-autoscaler.kubernetes.io/safe-to-evict": "false"
    },
    "labels": {
      "app": "example-dispatch"
    }
  },
  "spec": {
    "affinity": {
      "podAntiAffinity": {
        "requiredDuringSchedulingIgnoredDuringExecution": [
          {
            "labelSelector": {
              "matchLabels": {
                "app": "example-dispatch"
              }
            },
            "topologyKey": "kubernetes.io/hostname"
          }
        ]
      }
    },
    "containers": [
      {
        "command": [
          "/usr/local/bin/envoy-dispatch"
        ],
        "env": [
          {
            "name": "HOME",
            "value": "/home/envoy"
          },
          {
            "name": "DATABASE_URL",
            "valueFrom": {
              "secretKeyRef": {
                "key": "DATABASE_URL",
                "name": "example-dispatch-dispatch"
              }
            }
          },
          {
            "name": "DISPATCH_AGENT_TOKEN",
            "valueFrom": {
              "secretKeyRef": {
                "key": "DISPATCH_AGENT_TOKEN",
                "name": "example-dispatch-dispatch"
              }
            }
          },
          {
            "name": "DISPATCH_SIGNING_KEY",
            "valueFrom": {
              "secretKeyRef": {
                "key": "DISPATCH_SIGNING_KEY",
                "name": "example-dispatch-dispatch"
              }
            }
          },
          {
            "name": "DISPATCH_SIGNIN_CLIENT_SECRET",
            "valueFrom": {
              "secretKeyRef": {
                "key": "DISPATCH_SIGNIN_CLIENT_SECRET",
                "name": "example-dispatch-dispatch"
              }
            }
          },
          {
            "name": "DISPATCH_SIGNIN_ISSUER",
            "value": "https://accounts.google.com"
          },
          {
            "name": "DISPATCH_SIGNIN_CLIENT_ID",
            "value": "example-client-id"
          },
          {
            "name": "DISPATCH_SIGNIN_DOMAIN",
            "value": "example.com"
          },
          {
            "name": "DISPATCH_SERVER_URL",
            "value": "https://example-dispatch.example-tailnet.ts.net"
          },
          {
            "name": "DISPATCH_LISTEN_HOST",
            "value": "0.0.0.0"
          },
          {
            "name": "NATS_URLS",
            "value": "nats://example-hub.example-tailnet.ts.net:4222"
          },
          {
            "name": "ENVOY_ALLOW_REMOTE_NATS",
            "value": "1"
          },
          {
            "name": "NATS_NKEY_SEED_FILE",
            "value": "/var/run/secrets/envoy/nats-seed"
          },
          {
            "name": "ENVOY_NATS_SOCKS5_PROXY",
            "value": "example-dispatch-tailnet.dispatch.svc.cluster.local:1055"
          },
          {
            "name": "ENVOY_URL",
            "value": "http://example-dispatch-listener.dispatch.svc.cluster.local:9020"
          },
          {
            "name": "ENVOY_TOKEN",
            "valueFrom": {
              "secretKeyRef": {
                "key": "ENVOY_API_TOKEN",
                "name": "example-dispatch-listener"
              }
            }
          }
        ],
        "image": "example.invalid/envoy@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "lifecycle": {
          "preStop": {
            "exec": {
              "command": [
                "sleep",
                "5"
              ]
            }
          }
        },
        "livenessProbe": {
          "exec": {
            "command": [
              "curl",
              "-sS",
              "-o",
              "/dev/null",
              "--max-time",
              "8",
              "http://127.0.0.1:8766/healthz"
            ]
          },
          "failureThreshold": 3,
          "periodSeconds": 10,
          "timeoutSeconds": 9
        },
        "name": "envoy-dispatch",
        "readinessProbe": {
          "exec": {
            "command": [
              "curl",
              "-fsS",
              "http://127.0.0.1:8766/healthz"
            ]
          },
          "failureThreshold": 3,
          "initialDelaySeconds": 5,
          "periodSeconds": 10,
          "timeoutSeconds": 3
        },
        "resources": {
          "limits": {
            "cpu": "1",
            "memory": "4Gi"
          },
          "requests": {
            "cpu": "1",
            "memory": "4Gi"
          }
        },
        "startupProbe": {
          "exec": {
            "command": [
              "curl",
              "-sS",
              "-o",
              "/dev/null",
              "--max-time",
              "8",
              "http://127.0.0.1:8766/healthz"
            ]
          },
          "failureThreshold": 180,
          "periodSeconds": 10,
          "timeoutSeconds": 9
        },
        "volumeMounts": [
          {
            "mountPath": "/var/run/secrets/envoy",
            "name": "nats-seed",
            "readOnly": true
          }
        ]
      }
    ],
    "enableServiceLinks": false,
    "initContainers": [
      {
        "args": [
          "--private-ip",
          "--structured-logs",
          "--address=127.0.0.1",
          "--port=5432",
          "--health-check",
          "--http-address=0.0.0.0",
          "--http-port=9801",
          "example-project:us-central1:example-dispatch"
        ],
        "image": "example.invalid/cloud-sql-proxy@sha256:00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff",
        "livenessProbe": {
          "failureThreshold": 3,
          "httpGet": {
            "path": "/liveness",
            "port": 9801
          },
          "periodSeconds": 10,
          "timeoutSeconds": 5
        },
        "name": "cloud-sql-proxy",
        "resources": {
          "limits": {
            "cpu": "1",
            "memory": "2Gi"
          },
          "requests": {
            "cpu": "1",
            "memory": "2Gi"
          }
        },
        "restartPolicy": "Always",
        "securityContext": {
          "runAsNonRoot": true
        },
        "startupProbe": {
          "failureThreshold": 60,
          "httpGet": {
            "path": "/startup",
            "port": 9801
          },
          "periodSeconds": 1,
          "timeoutSeconds": 5
        }
      }
    ],
    "serviceAccountName": "example-dispatch",
    "terminationGracePeriodSeconds": 35,
    "topologySpreadConstraints": [
      {
        "labelSelector": {
          "matchLabels": {
            "app": "example-dispatch"
          }
        },
        "maxSkew": 1,
        "minDomains": 2,
        "topologyKey": "topology.kubernetes.io/zone",
        "whenUnsatisfiable": "DoNotSchedule"
      }
    ],
    "volumes": [
      {
        "csi": {
          "driver": "secrets-store-gke.csi.k8s.io",
          "readOnly": true,
          "volumeAttributes": {
            "secretProviderClass": "example-dispatch-nats-seed"
          }
        },
        "name": "nats-seed"
      }
    ]
  }
}
