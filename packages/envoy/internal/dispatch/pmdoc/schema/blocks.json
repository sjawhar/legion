{
  "version": 4,
  "types": [
    {
      "name": "callout",
      "content": "block+",
      "render": "host",
      "attributes": {
        "kind": {
          "kind": "enum",
          "choices": ["note", "warning"],
          "default": "note"
        },
        "title": {
          "kind": "string",
          "default": ""
        }
      }
    },
    {
      "name": "ask",
      "content": "paragraph+ bullet_list?",
      "render": "host",
      "attributes": {
        "shaped": {
          "kind": "block[]",
          "scope": "spec"
        },
        "urgency": {
          "kind": "enum",
          "choices": ["low", "med", "high", "blocking"],
          "default": "med"
        },
        "multiple": {
          "kind": "bool",
          "default": false
        },
        "state": {
          "kind": "enum",
          "choices": ["open", "answered", "resolved"],
          "default": "open",
          "server": true
        },
        "answered_by": {
          "kind": "actor",
          "server": true
        },
        "answered_at": {
          "kind": "timestamp",
          "server": true
        },
        "selected": {
          "kind": "string[]",
          "server": true
        },
        "answer": {
          "kind": "string",
          "server": true
        },
        "invalid": {
          "kind": "string",
          "server": true
        },
        "copied_from": {
          "kind": "string",
          "server": true
        },
        "copied_from_document": {
          "kind": "string",
          "server": true
        }
      }
    },
    {
      "name": "decision",
      "content": "block+",
      "render": "host",
      "attributes": {
        "title": { "kind": "string", "default": "" },
        "replaced": { "kind": "bool", "default": false },
        "shaped": { "kind": "block[]", "scope": "spec" },
        "from_ask": { "kind": "ask" },
        "decided_by": { "kind": "person" }
      }
    },
    {
      "name": "interpretation",
      "content": "paragraph+",
      "render": "host",
      "attributes": {
        "interprets": {
          "kind": "block[]",
          "targets": ["decision", "ask"],
          "scope": "document"
        }
      }
    },
    {
      "name": "requirement",
      "content": "paragraph+",
      "render": "host",
      "attributes": {}
    },
    {
      "name": "plan_task",
      "content": "paragraph+",
      "render": "host",
      "attributes": {
        "serves": {
          "kind": "block[]",
          "targets": ["requirement"]
        },
        "needs": {
          "kind": "block[]",
          "targets": ["plan_task"],
          "scope": "document"
        }
      }
    },
    {
      "name": "check",
      "content": "paragraph+",
      "render": "host",
      "attributes": {
        "serves": {
          "kind": "block[]",
          "targets": ["requirement"]
        },
        "surface": {
          "kind": "enum",
          "choices": ["browser", "cli", "api"]
        },
        "run": {
          "kind": "string"
        },
        "when": {
          "kind": "enum",
          "choices": ["before_merge", "after_merge", "default_branch"],
          "default": "before_merge"
        },
        "negative_control": {
          "kind": "string"
        }
      }
    }
  ]
}
