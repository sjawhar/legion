{
  "version": 3,
  "nodes": [
    { "name": "doc" },
    { "name": "paragraph" },
    { "name": "heading" },
    { "name": "blockquote" },
    { "name": "bullet_list" },
    { "name": "ordered_list" },
    { "name": "list_item" },
    { "name": "code_block" },
    { "name": "hr" },
    { "name": "hardbreak" },
    { "name": "image" },
    { "name": "html" },
    { "name": "table" },
    { "name": "table_header_row" },
    { "name": "table_row" },
    { "name": "table_cell" },
    { "name": "table_header" },
    { "name": "footnote_definition" },
    { "name": "footnote_reference" },
    { "name": "frontmatter" },
    { "name": "text" }
  ],
  "marks": [
    { "name": "strong" },
    { "name": "emphasis" },
    { "name": "inlineCode" },
    { "name": "link" },
    { "name": "strike_through" },
    { "name": "proofSuggestion" },
    { "name": "proofComment" },
    { "name": "proofFlagged" },
    { "name": "proofApproved" },
    { "name": "proofAuthored" },
    { "name": "dispatchAsk" }
  ],
  "types": [
    {
      "name": "callout",
      "content": "block+",
      "render": "host",
      "attributes": {
        "kind": {
          "kind": "enum",
          "choices": ["note", "warning"],
          "default": "note"
        },
        "title": {
          "kind": "string",
          "default": ""
        }
      }
    },
    {
      "name": "ask",
      "content": "paragraph+ bullet_list?",
      "render": "host",
      "attributes": {
        "urgency": {
          "kind": "enum",
          "choices": ["low", "med", "high", "blocking"],
          "default": "med"
        },
        "multiple": {
          "kind": "bool",
          "default": false
        },
        "state": {
          "kind": "enum",
          "choices": ["open", "answered", "resolved"],
          "default": "open",
          "server": true
        },
        "answered_by": {
          "kind": "actor",
          "server": true
        },
        "answered_at": {
          "kind": "timestamp",
          "server": true
        },
        "selected": {
          "kind": "string[]",
          "server": true
        },
        "answer": {
          "kind": "string",
          "server": true
        },
        "invalid": {
          "kind": "string",
          "server": true
        },
        "copied_from": {
          "kind": "string",
          "server": true
        },
        "copied_from_document": {
          "kind": "string",
          "server": true
        }
      }
    },
    {
      "name": "requirement",
      "content": "paragraph+",
      "render": "host",
      "attributes": {},
      "since": 3,
      "creatable_since": 3
    },
    {
      "name": "plan_task",
      "content": "paragraph+",
      "render": "host",
      "attributes": {
        "serves": {
          "kind": "block[]",
          "targets": ["requirement"]
        },
        "needs": {
          "kind": "block[]",
          "targets": ["plan_task"],
          "scope": "document"
        }
      },
      "since": 3,
      "creatable_since": 3
    },
    {
      "name": "check",
      "content": "paragraph+",
      "render": "host",
      "attributes": {
        "serves": {
          "kind": "block[]",
          "targets": ["requirement"]
        },
        "surface": {
          "kind": "enum",
          "choices": ["browser", "cli", "api"]
        },
        "run": {
          "kind": "string"
        },
        "when": {
          "kind": "enum",
          "choices": ["before_merge", "after_merge", "default_branch"],
          "default": "before_merge"
        },
        "negative_control": {
          "kind": "string"
        }
      },
      "since": 3,
      "creatable_since": 3
    }
  ]
}
