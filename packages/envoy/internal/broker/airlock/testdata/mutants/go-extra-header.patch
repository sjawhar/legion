 		return nil
 	}
-	names := sr.Headers
-	if names == nil {
-		names = []string{"authorization"}
-	}
+	// MUTANT: authorization is swapped too, even when the entry does not name it.
+	names := append([]string{"authorization"}, sr.Headers...)
 	out := *r
 	out.Headers = make([][2]string, len(r.Headers))
 	for i, h := range r.Headers {
