{
  "name": "@sjawhar/claude-envoy",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "Claude Code channel plugin for Legion's Envoy bus",
  "type": "module",
  "files": [
    ".claude-plugin/**",
    ".mcp.json",
    ".omp-plugin/**",
    "bin/**",
    "dist/**",
    "hooks/**",
    "legion/**",
    "scripts/**",
    "skills/**",
    "src/**",
    "README.md",
    "AGENTS.md"
  ],
  "legion": {
    "daemonApiVersion": 51
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cybermonklabs/legion"
  },
  "scripts": {
    "channel": "bun bin/envoy-channel.ts",
    "verify-build": "bash scripts/verify-build.sh",
    "prepack": "bash scripts/pack-skills.sh",
    "postpack": "bash scripts/pack-skills.sh --restore",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test --timeout=60000",
    "lint": "bunx biome check src/ hooks/ scripts/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@legion/contracts": "workspace:*",
    "@legion/envoy-client": "workspace:*",
    "@legion/pi-shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bun-types": "latest",
    "ky": "^2.0.2",
    "nats": "^2.29.2",
    "typescript": "^5.3.0",
    "zod": "4.3.6"
  }
}
