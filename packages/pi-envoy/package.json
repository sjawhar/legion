{
  "name": "@sjawhar/pi-envoy",
  "version": "8.3.0",
  "license": "Apache-2.0",
  "type": "module",
  "omp": {
    "extensions": [
      "extensions/envoy.ts"
    ],
    "skills": [
      "dist/skills"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sjawhar/legion"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "bun build extensions/envoy.ts --outdir dist --target bun --format esm --external @oh-my-pi/pi-coding-agent --external @oh-my-pi/pi-tui --external @oh-my-pi/pi-utils && ../envoy-client/scripts/build-dispatch-cli.sh dist",
    "prepack": "../../scripts/pi-plugin-prepack.sh",
    "postpack": "rm -rf dist/skills",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "lint": "bunx biome lint extensions/ src/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@legion/contracts": "workspace:*",
    "@legion/envoy-client": "workspace:*",
    "@legion/pi-shared": "workspace:*",
    "@oh-my-pi/pi-tui": "^18.6.0",
    "@oh-my-pi/pi-utils": "^18.6.0",
    "@toon-format/toon": "^4.1.1",
    "@types/bun": "latest",
    "nats": "^2.29.2",
    "typescript": "^5.3.0",
    "zod": "4.3.6"
  }
}
