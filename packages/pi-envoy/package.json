{
  "name": "@sjawhar/pi-legion-envoy",
  "version": "0.12.0",
  "type": "module",
  "omp": {
    "extensions": [
      "extensions/envoy.ts",
      "extensions/legion.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sjawhar/legion"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build extensions/envoy.ts extensions/legion.ts --outdir dist --target bun --format esm --external @oh-my-pi/pi-coding-agent --external @oh-my-pi/pi-tui --external @oh-my-pi/pi-utils",
    "prepack": "./scripts/prepack.sh",
    "postpack": "rm -rf dist/skills",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "lint": "bunx biome lint extensions/ src/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@legion/contracts": "workspace:*",
    "@legion/envoy-client": "workspace:*",
    "@oh-my-pi/pi-tui": "^18.1.15",
    "@oh-my-pi/pi-utils": "^18.1.15",
    "@toon-format/toon": "^4.1.1",
    "@types/bun": "latest",
    "nats": "^2.29.2",
    "typescript": "^5.3.0",
    "zod": "^4.1.8"
  }
}
