{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun", "vite/client"]
  },
  "include": ["web/src/**/*.ts", "web/src/**/*.tsx", "web/vite.config.ts", "e2e/**/*.ts"]
}
