{
  "name": "@sjawhar/dispatch",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "test": "bun test web/src",
    "e2e": "VITE_DISPATCH_E2E=1 bun run build:web && playwright test --config e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check web/src e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@happy-dom/global-registrator": "^20.14.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.14.0",
    "typescript": "^5",
    "vite": "^5"
  },
  "dependencies": {
    "@hocuspocus/provider": "^2.15.2",
    "@sjawhar/proof-editor": "0.2.1",
    "@legion/contracts": "workspace:*",
    "@milkdown/core": "^7.18.0",
    "@milkdown/kit": "^7.18.0",
    "@milkdown/plugin-clipboard": "^7.18.0",
    "@milkdown/plugin-collab": "^7.18.0",
    "@milkdown/plugin-cursor": "^7.18.0",
    "@milkdown/plugin-history": "^7.18.0",
    "@milkdown/plugin-listener": "^7.18.0",
    "@milkdown/preset-commonmark": "^7.18.0",
    "@milkdown/preset-gfm": "^7.18.0",
    "@milkdown/prose": "^7.18.0",
    "@milkdown/theme-nord": "^7.18.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "prosemirror-model": "^1.25.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6",
    "remark-frontmatter": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.32"
  }
}
