{
  "name": "@sjawhar/dispatch",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "test": "bun test web/src",
    "e2e": "bun run build:web && playwright test --config e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check web/src e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@happy-dom/global-registrator": "^20.14.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.14.0",
    "typescript": "^5",
    "vite": "^5"
  },
  "dependencies": {
    "@legion/contracts": "workspace:*",

    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5",
    "beautiful-mermaid": "^1.1.3",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3"
  }
}
