{
  "mcpServers": {
    "envoy": {
      "command": "bun",
      "args": ["run", "--cwd", "${CLAUDE_PLUGIN_ROOT}", "--silent", "channel"],
      "env": {
        "ENVOY_NATS_URL": "${ENVOY_NATS_URL}",
        "ENVOY_URL": "${ENVOY_URL}",
        "ENVOY_SESSION_ID": "${ENVOY_SESSION_ID}",
        "CLAUDE_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}"
      }
    }
  }
}
