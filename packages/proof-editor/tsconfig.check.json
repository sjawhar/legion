{
  // Tsc reads `upstream/` — the declarations generated from the pinned upstream sources — rather
  // than opening those sources, which do not type-check. Bun and Vite resolve the sources for
  // runtime; see tsconfig.json and packages/dispatch/web/vite.config.ts.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "proof-sdk-upstream/src/*": ["./upstream/*"]
    }
  }
}
