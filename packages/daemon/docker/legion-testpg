#!/bin/sh
# legion-testpg: the pod's own PostgreSQL for tests, on loopback, from the server the worker image
# ships. `ensure` serves exactly the server LEGION_TEST_PG_DSN names, so the deployment's DSN is the
# one contract and no caller has to agree on a port. A DSN naming anything but a loopback host, or
# carrying a password, is refused rather than served: this script never serves a database that holds
# real rows. The refusal binds this script alone — it does not stop a test from opening a sessions
# DSN it was handed, which is why the runtime refuses LEGION_TEST_PG_DSN in a deployment's pod.env
# and sets it itself.
#
# The data directory is LEGION_TESTPG_DIR, /var/run/legion/roles/testpg: a disk emptyDir the daemon
# mounts there, which the kubelet makes with the pod and deletes with it, so every issue pod gets an
# empty cluster and nothing of one issue's tests reaches another. Every role's own mounts cover that
# path inside the role's namespace, so no role can edit postgresql.auto.conf and have the next start
# load it into the launcher's namespace.
#
# The issue pod's launcher runs `ensure` at container start, as PID 1 of the roles container and
# outside every role's PID namespace, and again if the postmaster dies; a role never starts the
# server, it finds it listening. `ensure` is idempotent and holds a lock over the work all the same.
#
# initdb's superuser is the OS user (`id -un`, legion). The DSN names another role, created after
# the server is up with LOGIN CREATEDB NOSUPERUSER, because a superuser can run
# `copy … to program '…'`, which runs as the server process — in the roles container's own
# namespace, where every role's tokens live.
set -eu

name=legion-testpg
dir=${LEGION_TESTPG_DIR:-/var/run/legion/roles/testpg}
data=$dir/data
sockets=$dir/sockets
log=$dir/server.log
superuser=$(id -un)

die() {
	echo "$name: $*" >&2
	exit 1
}

# bindir is the newest PostgreSQL server bin directory Debian's postgresql-<major> packages install
# (PGBIN overrides it). The server programs are not on PATH: postgresql-common wraps the client
# programs alone (psql, pg_isready, createdb), so initdb, pg_ctl and postgres are named by path.
bindir() {
	if [ -n "${PGBIN:-}" ]; then
		echo "$PGBIN"
		return
	fi
	newest=
	for candidate in /usr/lib/postgresql/*/bin; do
		[ -x "$candidate/postgres" ] || continue
		version=${candidate#/usr/lib/postgresql/}
		version=${version%/bin}
		case $version in
		'' | *[!0-9]*) continue ;;
		esac
		if [ -z "$newest" ] || [ "$version" -gt "$newest" ]; then
			newest=$version
		fi
	done
	[ -n "$newest" ] || die "no PostgreSQL server under /usr/lib/postgresql/*/bin: this image ships none"
	echo "/usr/lib/postgresql/$newest/bin"
}

# parse_dsn sets user, host, port and database from a DSN, and refuses one this script must not
# serve: a password means the DSN names a server with accounts, which is somebody else's, and a
# host that is not loopback means a server outside this pod, where creating and dropping databases
# is not ours to do. The user and the database are held to plain identifiers because start() names
# both in SQL and in pg_hba.conf.
parse_dsn() {
	rest=${1#postgres://}
	if [ "$rest" = "$1" ]; then
		rest=${1#postgresql://}
		[ "$rest" != "$1" ] || die "DSN $1 is no postgres:// URL"
	fi
	rest=${rest%%\?*}
	case $rest in
	*@*) ;;
	*) die "DSN names no user before @: nothing names the role to create" ;;
	esac
	user=${rest%%@*}
	rest=${rest#*@}
	case $user in
	*:*) die "DSN carries a password, so it names a server with accounts, not this pod's own" ;;
	'') die "DSN names an empty user" ;;
	*[!A-Za-z0-9_]*) die "DSN names user $user, which is no plain identifier" ;;
	esac
	case $rest in
	*/*)
		database=${rest#*/}
		rest=${rest%%/*}
		;;
	*) die "DSN names no database" ;;
	esac
	host=${rest%%:*}
	port=${rest#*:}
	if [ "$port" = "$rest" ]; then
		port=5432
	fi
	# No bracketed [::1] arrives here: the host is everything before the first colon, so an IPv6
	# literal would already have lost its tail.
	case $host in
	127.0.0.1 | localhost) ;;
	*) die "DSN names host $host, which is no loopback address: a test database is this pod's own" ;;
	esac
	case $port in
	'' | *[!0-9]*) die "DSN names port $port, which is no number" ;;
	esac
	case $database in
	'' | *[!A-Za-z0-9_]*) die "DSN names database $database, which is no plain identifier" ;;
	esac
}

listening() {
	pg_isready -q -h 127.0.0.1 -p "$port"
}

# answering: a server holds the port, ready (0) or starting or recovering (1); 2 is no server.
answering() {
	pg_isready -q -h 127.0.0.1 -p "$port" || [ $? -ne 2 ]
}

# super runs psql as the initdb superuser over the local socket, the one route pg_hba.conf admits
# it on: the superuser has no host line, so nothing that reaches 127.0.0.1 can be it.
super() {
	psql -X -q -h "$sockets" -p "$port" -U "$superuser" "$@"
}

start() {
	bin=$(bindir)
	mkdir -p "$data" "$sockets"
	chmod 700 "$data"
	# An interrupted initdb leaves a directory with no PG_VERSION, which no server starts on.
	if [ ! -f "$data/PG_VERSION" ]; then
		rm -rf "${data:?}"/* "${data:?}"/.[!.]* 2> /dev/null || true
		# --locale-provider=icu with en-US sorts text the way CI's en_US.utf8 databases do: a
		# suite whose ORDER BY output is a fixture would otherwise pass here and fail there on
		# C collation. --username keeps the OS user as the superuser; the DSN's role is made
		# below, with no superuser rights.
		"$bin/initdb" --pgdata "$data" --username "$superuser" --auth-local=trust \
			--auth-host=trust --encoding=UTF8 --locale-provider=icu --icu-locale=en-US \
			--no-sync > "$log" 2>&1 ||
			die "initdb failed; $log holds its output"
		# initdb's own pg_hba.conf trusts every user on every address this server listens on.
		# This one admits the superuser on the socket alone and the DSN's role on loopback, and
		# rejects the rest, so a connection that arrives over TCP cannot be the superuser.
		printf '%s\n' \
			"local all  $superuser  trust" \
			"host  all  $user  127.0.0.1/32 trust" \
			"host  all  all  0.0.0.0/0 reject" > "$data/pg_hba.conf" ||
			die "writing $data/pg_hba.conf failed"
	fi
	# This process holds the lock and no server answers, so a postmaster.pid or socket lock left
	# here names a server that died with its PID namespace; postgres would test that PID in this
	# namespace, where it may be a live process.
	answering || rm -f "$data/postmaster.pid" "$sockets/.s.PGSQL.$port.lock"
	# A throwaway cluster trades durability for speed: nothing in it survives the pod. 100
	# connections cover a package's parallel tests, and 256MB of shared buffers their fixtures.
	# huge_pages and dynamic_shared_memory_type are the pod's: gVisor serves no huge pages, and
	# each role mounts its own 64 MiB /dev/shm, too small for the posix segments the default
	# picks. jit off keeps LLVM out of a test's plan times.
	"$bin/pg_ctl" --pgdata "$data" --log "$log" --wait --timeout 120 \
		--options "-p $port -k $sockets -c listen_addresses=127.0.0.1 -c fsync=off -c full_page_writes=off -c synchronous_commit=off -c max_connections=100 -c shared_buffers=256MB -c huge_pages=off -c dynamic_shared_memory_type=mmap -c jit=off" \
		start >> "$log" 2>&1 ||
		die "pg_ctl start failed; $log holds its output"
	# vector in template1 reaches every database a test makes from it, so a suite that needs
	# pgvector (Dispatch's) runs on this server with no extension step of its own, and a
	# `create extension if not exists vector` of its own is a no-op the DSN's role may run.
	super -d template1 -c 'create extension if not exists vector' >> "$log" 2>&1 ||
		die "create extension vector in template1 failed; $log holds its output"
	# The DSN's role: it may log in and make databases, and it is no superuser, so nothing that
	# holds the DSN can `copy … to program` as the server's own process.
	super -tA -d postgres -c "select 1 from pg_roles where rolname = '$user'" 2>> "$log" |
		grep -q 1 ||
		super -d postgres -c "create role $user login createdb nosuperuser" >> "$log" 2>&1 ||
		die "create role $user failed; $log holds its output"
	if [ "$database" != postgres ]; then
		super -tA -d postgres -c "select 1 from pg_database where datname = '$database'" 2>> "$log" |
			grep -q 1 ||
			super -d postgres -c "create database $database owner $user" >> "$log" 2>&1 ||
			die "create database $database failed; $log holds its output"
	fi
}

ensure() {
	[ -n "${LEGION_TEST_PG_DSN:-}" ] ||
		die "LEGION_TEST_PG_DSN is unset: nothing names the server to serve"
	parse_dsn "$LEGION_TEST_PG_DSN"
	listening && {
		echo "$name: a server already answers on 127.0.0.1:$port"
		return 0
	}
	mkdir -p "$dir"
	# flock serialises the callers that start together; the second finds the first's server
	# listening. -o closes the lock's descriptor in the child, so the server flock's child starts
	# does not inherit it and hold the lock for the pod's whole life: without -o, measured, a
	# second ensure blocked until its own timeout. -w bounds the wait at one cold start, so a
	# holder that dies mid-start costs one wait and never a launch; -E makes that timeout 75, a
	# status no command of start-locked returns, so the wait is reported rather than silent.
	flock -E 75 -w 180 -o "$dir/.lock" "$0" start-locked || {
		s=$?
		[ "$s" -ne 75 ] || die "waited 180 s for $dir/.lock"
		exit "$s"
	}
	echo "$name: serving $LEGION_TEST_PG_DSN from $data"
}

case ${1:-} in
ensure)
	ensure
	;;
start-locked)
	# flock's child: the environment names the DSN, and another caller may have started the server
	# while this one waited for the lock.
	parse_dsn "${LEGION_TEST_PG_DSN:?}"
	listening || start
	;;
stop)
	# A fast shutdown this waits for: the postmaster's exit leaves its shutdown checkpoint still
	# running, and a caller that deletes the data directory next races it. The data directory is
	# all pg_ctl needs, so `stop` reads LEGION_TESTPG_DIR alone, not the DSN.
	bin=$(bindir)
	"$bin/pg_ctl" --pgdata "$data" --mode fast --wait --timeout 60 stop
	;;
check)
	# The image probe's toolchain check runs this: a worker image whose server package went missing
	# fails the build instead of every role's start.
	bin=$(bindir)
	"$bin/postgres" --version
	"$bin/initdb" --version
	control=$(pg_config --sharedir)/extension/vector.control
	[ -f "$control" ] || die "no pgvector: $control is missing"
	echo "pgvector $(sed -n "s/^default_version = '\(.*\)'/\1/p" "$control")"
	;;
*)
	die "usage: $name ensure|check|stop"
	;;
esac
