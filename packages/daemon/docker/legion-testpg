#!/bin/sh
# legion-testpg: the pod's own PostgreSQL for tests, on loopback, from the server the worker image
# ships. `ensure` serves exactly the server LEGION_TEST_PG_DSN names, so the deployment's DSN is the
# one contract and no caller has to agree on a port. A DSN naming anything but a loopback host, or
# carrying a password, is refused rather than served: this script never serves a database that holds
# real rows. The refusal binds this script alone — it does not stop a test from opening a sessions
# DSN it was handed, which is why the runtime refuses LEGION_TEST_PG_DSN in a deployment's pod.env
# and sets it itself.
#
# The data directory is LEGION_TESTPG_DIR, /var/run/legion/roles/testpg: a disk emptyDir the daemon
# mounts there, which the kubelet makes with the pod and deletes with it, so every issue pod gets an
# empty cluster and nothing of one issue's tests reaches another. Every role's own mounts cover that
# path inside the role's namespace, so no role can edit postgresql.auto.conf and have the next start
# load it into the launcher's namespace.
#
# The issue pod's launcher runs `ensure` at container start, as PID 1 of the roles container and
# outside every role's PID namespace, and again every 15 s; a role never starts the server, it
# finds it serving. `ensure` is idempotent, holds a lock over the work all the same, and tests the
# DSN rather than the port, so a start that died with the postmaster up and its post-start steps
# unfinished is carried the rest of the way by the tick that follows rather than reported served.
#
# initdb's superuser is the OS user (`id -un`, legion). The DSN names another role, created after
# the server is up with LOGIN CREATEDB CREATEROLE NOSUPERUSER, because a superuser can run
# `copy … to program '…'`, which runs as the server process — in the roles container's own
# namespace, where every role's tokens live. CREATEROLE is there because this repository's own
# suites create a login role and connect as it (packages/envoy/internal/broker/store/iam_test.go,
# packages/envoy/internal/dispatch/store/census_test.go), and a test that passes in CI and fails in
# the pod is what sends an agent to the deployment's sessions database; measured on 18, a CREATEROLE
# non-superuser can neither make a superuser, nor grant itself one, nor grant pg_execute_server_program.
set -eu

name=legion-testpg
dir=${LEGION_TESTPG_DIR:-/var/run/legion/roles/testpg}
data=$dir/data
sockets=$dir/sockets
log=$dir/server.log
superuser=$(id -un)

die() {
	echo "$name: $*" >&2
	exit 1
}

# bindir is the newest PostgreSQL server bin directory Debian's postgresql-<major> packages install
# (PGBIN overrides it). The server programs are not on PATH: postgresql-common wraps the client
# programs alone (psql, pg_isready, createdb), so initdb, pg_ctl and postgres are named by path.
bindir() {
	if [ -n "${PGBIN:-}" ]; then
		echo "$PGBIN"
		return
	fi
	newest=
	for candidate in /usr/lib/postgresql/*/bin; do
		[ -x "$candidate/postgres" ] || continue
		version=${candidate#/usr/lib/postgresql/}
		version=${version%/bin}
		case $version in
		'' | *[!0-9]*) continue ;;
		esac
		if [ -z "$newest" ] || [ "$version" -gt "$newest" ]; then
			newest=$version
		fi
	done
	[ -n "$newest" ] || die "no PostgreSQL server under /usr/lib/postgresql/*/bin: this image ships none"
	echo "/usr/lib/postgresql/$newest/bin"
}

# parse_dsn sets user, host, port and database from a DSN, and refuses one this script must not
# serve: a password means the DSN names a server with accounts, which is somebody else's, and a
# host that is not loopback means a server outside this pod, where creating and dropping databases
# is not ours to do. The user and the database are held to plain identifiers because start() names
# both in SQL and in pg_hba.conf.
parse_dsn() {
	rest=${1#postgres://}
	if [ "$rest" = "$1" ]; then
		rest=${1#postgresql://}
		[ "$rest" != "$1" ] || die "DSN $1 is no postgres:// URL"
	fi
	rest=${rest%%\?*}
	case $rest in
	*@*) ;;
	*) die "DSN names no user before @: nothing names the role to create" ;;
	esac
	user=${rest%%@*}
	rest=${rest#*@}
	case $user in
	*:*) die "DSN carries a password, so it names a server with accounts, not this pod's own" ;;
	'') die "DSN names an empty user" ;;
	*[!A-Za-z0-9_]*) die "DSN names user $user, which is no plain identifier" ;;
	esac
	case $rest in
	*/*)
		database=${rest#*/}
		rest=${rest%%/*}
		;;
	*) die "DSN names no database" ;;
	esac
	host=${rest%%:*}
	port=${rest#*:}
	if [ "$port" = "$rest" ]; then
		port=5432
	fi
	# No bracketed [::1] arrives here: the host is everything before the first colon, so an IPv6
	# literal would already have lost its tail.
	case $host in
	127.0.0.1 | localhost) ;;
	*) die "DSN names host $host, which is no loopback address: a test database is this pod's own" ;;
	esac
	case $port in
	'' | *[!0-9]*) die "DSN names port $port, which is no number" ;;
	esac
	case $database in
	'' | *[!A-Za-z0-9_]*) die "DSN names database $database, which is no plain identifier" ;;
	esac
}

# serving: the DSN works — a server answers on the port it names and the role and the database it
# names are there. This is what `ensure` reports and what start-locked tests. A port test is not
# enough: start() has the postmaster up before it makes the role, `vector` in template1 and the
# DSN's database, so any failure after that leaves a server answering the port with no usable DSN,
# and a port test would call that served for the pod's whole life. -w never prompts for a password
# (the DSN carries none and pg_hba trusts loopback, so a prompt would mean something is wrong, not
# something to wait on) and PGCONNECT_TIMEOUT bounds the connect, so a half-open port costs one
# tick and never holds the launcher.
serving() {
	PGCONNECT_TIMEOUT=5 psql -X -w -tAq "$LEGION_TEST_PG_DSN" -c 'select 1' > /dev/null 2>&1
}

# listening: a server on the port accepts connections. start() tests this rather than the DSN to
# decide whether to launch a postmaster, because `pg_ctl start` against a running server fails:
# the postmaster is started only when there is none, and the steps after it then run against the
# server that is already up.
listening() {
	pg_isready -q -h 127.0.0.1 -p "$port"
}

# answering: a server holds the port, ready (0) or starting or recovering (1); 2 is no server.
answering() {
	pg_isready -q -h 127.0.0.1 -p "$port" || [ $? -ne 2 ]
}

# holders: true when some process other than this one has $1 as its working directory. The
# postmaster chdirs into the data directory and its backends inherit that, so this is what tells a
# server whose backends are still alive from one that is really gone. A /proc entry that vanishes
# between the glob and the readlink, and one this user may not read, are both skipped: neither can
# be a backend of a cluster this user started.
holders() {
	target=$(cd "$1" 2> /dev/null && pwd -P) || return 1
	for entry in /proc/[0-9]*; do
		[ "${entry#/proc/}" != "$$" ] || continue
		cwd=$(readlink "$entry/cwd" 2> /dev/null) || continue
		[ "$cwd" != "$target" ] || return 0
	done
	return 1
}

# super runs psql as the initdb superuser over the local socket, the one route pg_hba.conf admits
# it on: every host line rejects the superuser, so nothing that reaches 127.0.0.1 can be it.
super() {
	psql -X -q -h "$sockets" -p "$port" -U "$superuser" "$@"
}

start() {
	bin=$(bindir)
	mkdir -p "$data" "$sockets"
	chmod 700 "$data"
	# start() is reached with no server, and also with one this script started and did not
	# finish: every step below the postmaster can die with the postmaster up, and the tick that
	# follows has to carry that server the rest of the way. So each step here is idempotent, and
	# the postmaster is launched only when nothing accepts connections on the port — `pg_ctl
	# start` against a running server fails, which would turn a repair into a refusal.
	if ! listening; then
		# An interrupted initdb leaves a directory with no PG_VERSION, which no server starts on.
		if [ ! -f "$data/PG_VERSION" ]; then
			rm -rf "${data:?}"/* "${data:?}"/.[!.]* 2> /dev/null || true
			# --locale-provider=icu with en-US sorts text the way CI's en_US.utf8 databases
			# do: a suite whose ORDER BY output is a fixture would otherwise pass here and
			# fail there on C collation. --username keeps the OS user as the superuser; the
			# DSN's role is made below, with no superuser rights.
			"$bin/initdb" --pgdata "$data" --username "$superuser" --auth-local=trust \
				--auth-host=trust --encoding=UTF8 --locale-provider=icu --icu-locale=en-US \
				--no-sync > "$log" 2>&1 ||
				die "initdb failed; $log holds its output"
		fi
		# initdb's own pg_hba.conf trusts every user on every address this server listens on.
		# This one keeps the superuser on the socket alone and rejects it on every host line,
		# so a connection that arrives over TCP can never be the superuser, and trusts every
		# other role on loopback, so a login role a test creates can connect as itself. It is
		# written before every launch, not at initdb alone: a start that died between initdb
		# and here would otherwise leave the next launch reading initdb's file. A server that
		# is already up read this same file, from the launch that started it.
		printf '%s\n' \
			"local all  $superuser  trust" \
			"host  all  $superuser  all  reject" \
			"host  all  all  127.0.0.1/32 trust" \
			"host  all  all  0.0.0.0/0 reject" > "$data/pg_hba.conf" ||
			die "writing $data/pg_hba.conf failed"
		# This process holds the lock and no server answers, so a postmaster.pid or socket
		# lock left here names a server that died with its PID namespace; postgres would test
		# that PID in this namespace, where it may be a live process. A postmaster that is
		# gone can still have live backends, which hold the data directory as their working
		# directory and would write it beside a new server, so the files are cleared only
		# when no process is in there.
		if [ -f "$data/postmaster.pid" ] || [ -e "$sockets/.s.PGSQL.$port.lock" ]; then
			if ! answering; then
				! holders "$data" ||
					die "a process still runs in $data, so the server that left $data/postmaster.pid is not gone: refusing to clear it"
				rm -f "$data/postmaster.pid" "$sockets/.s.PGSQL.$port.lock"
			fi
		fi
		# A throwaway cluster trades durability for speed: nothing in it survives the pod. 100
		# connections cover a package's parallel tests, and 256MB of shared buffers their
		# fixtures. huge_pages and dynamic_shared_memory_type are the pod's: gVisor serves no
		# huge pages, and each role mounts its own 64 MiB /dev/shm, too small for the posix
		# segments the default picks. jit off keeps LLVM out of a test's plan times. The WAL
		# settings bound the cluster's share of whatever ephemeral-storage limit the pod runs
		# under, which the kubelet evicts every role of the pod over: the daemon's own default
		# is 80Gi on a 6Gi request (`defaultResources`), and a deployment that sets
		# `runtime.kubernetes.resources.issue` names its own — one Autopilot deployment gives
		# its issue pods 10Gi. Each setting is below its default: wal_level=minimal
		# writes no WAL at all for a table built, copied into or rewritten in the transaction
		# that made it, which is most of what a suite's fixture does (and it needs
		# max_wal_senders=0, since no walsender can serve that level, and no replication slot
		# can exist to pin segments); max_wal_size=512MB halves the checkpoint distance, and
		# with it the recycled segments a long run settles at; min_wal_size=64MB lets the floor
		# fall to four segments between runs; and wal_keep_size=0 retains nothing for a replica
		# this cluster will never have. Measured on 18: a database grown to 985 MB, updated
		# across a third of its rows, VACUUM FULLed and dropped left the data directory at
		# 1.1 GB with the defaults and at 425 MB with these.
		# shellcheck disable=SC2094 # pg_ctl writes $log through --log and this append; it reads none
		"$bin/pg_ctl" --pgdata "$data" --log "$log" --wait --timeout 120 \
			--options "-p $port -k $sockets -c listen_addresses=127.0.0.1 -c fsync=off -c full_page_writes=off -c synchronous_commit=off -c max_connections=100 -c shared_buffers=256MB -c huge_pages=off -c dynamic_shared_memory_type=mmap -c jit=off -c wal_level=minimal -c max_wal_senders=0 -c max_wal_size=512MB -c min_wal_size=64MB -c wal_keep_size=0" \
			start >> "$log" 2>&1 ||
			die "pg_ctl start failed; $log holds its output"
	fi
	# vector in template1 reaches every database a test makes from it, so a suite that needs
	# pgvector (Dispatch's) runs on this server with no extension step of its own, and a
	# `create extension if not exists vector` of its own is a no-op the DSN's role may run.
	super -d template1 -c 'create extension if not exists vector' >> "$log" 2>&1 ||
		die "create extension vector in template1 failed; $log holds its output"
	# The DSN's role: it may log in, make databases and make roles, and it is no superuser, so
	# nothing that holds the DSN can `copy … to program` as the server's own process. CREATEROLE
	# is what lets a suite that creates its own login role run here as it does in CI; on 18 it
	# cannot hand out SUPERUSER or a role it does not hold itself, such as
	# pg_execute_server_program.
	super -tA -d postgres -c "select 1 from pg_roles where rolname = '$user'" 2>> "$log" |
		grep -q 1 ||
		super -d postgres -c "create role $user login createdb createrole nosuperuser" >> "$log" 2>&1 ||
		die "create role $user failed; $log holds its output"
	if [ "$database" != postgres ]; then
		super -tA -d postgres -c "select 1 from pg_database where datname = '$database'" 2>> "$log" |
			grep -q 1 ||
			super -d postgres -c "create database $database owner $user" >> "$log" 2>&1 ||
			die "create database $database failed; $log holds its output"
	fi
}

ensure() {
	[ -n "${LEGION_TEST_PG_DSN:-}" ] ||
		die "LEGION_TEST_PG_DSN is unset: nothing names the server to serve"
	parse_dsn "$LEGION_TEST_PG_DSN"
	serving && {
		echo "$name: a server already serves 127.0.0.1:$port"
		return 0
	}
	mkdir -p "$dir"
	# flock serialises the callers that start together; the second finds the first's server
	# serving. -o closes the lock's descriptor in the child, so the server flock's child starts
	# does not inherit it and hold the lock for the pod's whole life: without -o, measured, a
	# second ensure blocked until its own timeout. -w bounds the wait at one cold start, so a
	# holder that dies mid-start costs one wait and never a launch; -E makes that timeout 75, a
	# status no command of start-locked returns, so the wait is reported rather than silent.
	flock -E 75 -w 180 -o "$dir/.lock" "$0" start-locked || {
		s=$?
		[ "$s" -ne 75 ] || die "waited 180 s for $dir/.lock"
		exit "$s"
	}
	# A start that no later start repairs — a role the cluster holds as NOLOGIN, a password set on
	# it, an hba file an earlier version wrote — would be reported as served on every tick for the
	# pod's life, and nothing in the log would say the DSN does not work. So the DSN is tried
	# again here. A start that worked can still fail this probe: PGCONNECT_TIMEOUT bounds the
	# connect alone, not psql's whole run, so a loaded box answers late (measured: 48 ms median,
	# 23.5 s worst of 40 samples), and a suite holding every one of the 100 connections leaves
	# none for the probe. Hence the second try, and a message that names those two before the
	# cluster's own faults.
	serving || sleep 2
	serving ||
		die "the server started but $LEGION_TEST_PG_DSN did not answer twice running; it may be slow under load or out of connections (max_connections=100), or the cluster's role or hba file may be wrong: $log holds the server's output"
	echo "$name: serving $LEGION_TEST_PG_DSN from $data"
}

case ${1:-} in
ensure)
	ensure
	;;
start-locked)
	# flock's child: the environment names the DSN, and another caller may have finished the
	# server while this one waited for the lock.
	parse_dsn "${LEGION_TEST_PG_DSN:?}"
	serving || start
	;;
stop)
	# A fast shutdown this waits for: the postmaster's exit leaves its shutdown checkpoint still
	# running, and a caller that deletes the data directory next races it. The data directory is
	# all pg_ctl needs, so `stop` reads LEGION_TESTPG_DIR alone, not the DSN.
	bin=$(bindir)
	"$bin/pg_ctl" --pgdata "$data" --mode fast --wait --timeout 60 stop
	;;
check)
	# The image probe's toolchain check runs this: a worker image whose server package went missing
	# fails the build instead of every role's start.
	bin=$(bindir)
	"$bin/postgres" --version
	"$bin/initdb" --version
	control=$(pg_config --sharedir)/extension/vector.control
	[ -f "$control" ] || die "no pgvector: $control is missing"
	echo "pgvector $(sed -n "s/^default_version = '\(.*\)'/\1/p" "$control")"
	;;
*)
	die "usage: $name ensure|check|stop"
	;;
esac
