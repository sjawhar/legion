{
  "name": "legion",
  "version": "0.5.0",
  "type": "module",
  "description": "Autonomous development swarm running on the OMP coding agent",
  "bin": {
    "legion": "src/cli/index.ts"
  },
  "scripts": {
    "start:daemon": "bun run src/daemon/index.ts",
    "test": "bun test",
    "lint": "bunx biome check src/",
    "typecheck": "bunx tsc --noEmit",
    "format": "bunx biome format src/ --write"
  },
  "dependencies": {
    "@legion/contracts": "workspace:*",
    "@legion/workspace": "workspace:*",
    "citty": "^0.2.0",
    "nats": "^2.29.2",
    "yaml": "^2.8.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "latest",
    "graphql": "^17.0.2",
    "typescript": "^5.3.0"
  }
}
