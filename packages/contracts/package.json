{
  "name": "@legion/contracts",
  "version": "0.10.0",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./repo": {
      "types": "./src/repo.ts",
      "bun": "./src/repo.ts",
      "default": "./dist/repo.js"
    },
    "./dispatch-snippet": {
      "types": "./src/dispatch-snippet.ts",
      "bun": "./src/dispatch-snippet.ts",
      "default": "./dist/dispatch-snippet.js"
    },
    "./dispatch-tools": {
      "types": "./src/dispatch-tools.ts",
      "bun": "./src/dispatch-tools.ts",
      "default": "./dist/dispatch-tools.js"
    },
    "./legion-api": {
      "types": "./src/legion-api.ts",
      "bun": "./src/legion-api.ts",
      "default": "./dist/legion-api.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "gen:go": "bun run scripts/gen-go.ts",
    "check:go": "bun run scripts/gen-go.ts --check",
    "build": "bun build src/index.ts src/repo.ts src/dispatch-snippet.ts src/dispatch-tools.ts src/legion-api.ts --outdir dist --target bun --format esm",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "lint": "bunx biome check src/ schemas/"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  }
}
