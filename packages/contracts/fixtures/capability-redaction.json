{
  "note": "Go's (?i) folds U+212A (Kelvin sign) and U+017F (long s) to k and s, where JavaScript's /i does not, so on a detail holding either the daemon masks more than the plugin, by design: the daemon's cleaning is the one the store and the state keep. No case here holds either.",
  "patterns": [
    {
      "pattern": "url-userinfo",
      "name": "a user and a password",
      "detail": "fetch failed: https://user:hunter2@mcp.example/sse (HTTP 401)",
      "want": "fetch failed: https://***@mcp.example/sse (HTTP 401)"
    },
    {
      "pattern": "url-userinfo",
      "name": "a user alone",
      "detail": "clone of https://oauth2token@git.example/acme/widgets.git refused",
      "want": "clone of https://***@git.example/acme/widgets.git refused"
    },
    {
      "pattern": "url-userinfo",
      "name": "a password holding an at sign",
      "detail": "dial postgres://legion:p@ss@db.example:5432/legion: refused",
      "want": "dial postgres://***@db.example:5432/legion: refused"
    },
    {
      "pattern": "url-userinfo",
      "name": "a scheme glued to the digits before it",
      "detail": "retry 1https://user:hunter2@mcp.example/sse failed",
      "want": "retry 1https://***@mcp.example/sse failed"
    },
    {
      "pattern": "query-credential",
      "name": "every credential parameter in any case, and no parameter that only ends in one's name",
      "detail": "GET https://api.example/v1/search?q=jj&token=t0k&Key=k3y&secret=s3c&password=pw&ACCESS_TOKEN=at&refresh_token=rt&id_token=it&api_key=ak&apikey=ak2&client_secret=cs&sig=s1g&X-Amz-Security-Token=st&X-Amz-Signature=as&page_token=next: 401",
      "want": "GET https://api.example/v1/search?q=jj&token=***&Key=***&secret=***&password=***&ACCESS_TOKEN=***&refresh_token=***&id_token=***&api_key=***&apikey=***&client_secret=***&sig=***&X-Amz-Security-Token=***&X-Amz-Signature=***&page_token=next: 401"
    },
    {
      "pattern": "query-credential",
      "name": "more credential parameters, camelCase among them",
      "detail": "GET https://git.example/api/v4/projects?private_token=pt&auth_token=at2&accessToken=ct&Signature=sg&X-Goog-Signature=gs&page=2: 401",
      "want": "GET https://git.example/api/v4/projects?private_token=***&auth_token=***&accessToken=***&Signature=***&X-Goog-Signature=***&page=2: 401"
    },
    {
      "pattern": "query-credential",
      "name": "a value up to the quote that closes its URL",
      "detail": "connect \"https://mcp.example/sse?token=abc123\" failed",
      "want": "connect \"https://mcp.example/sse?token=***\" failed"
    },
    {
      "pattern": "connection-string-password",
      "name": "an unquoted password",
      "detail": "connect host=db.example user=legion password=pgSecret123 dbname=legion: refused",
      "want": "connect host=db.example user=legion password=*** dbname=legion: refused"
    },
    {
      "pattern": "connection-string-password",
      "name": "a quoted password, its quotes kept",
      "detail": "connect host=db.example password='pg secret' dbname=legion: refused",
      "want": "connect host=db.example password='***' dbname=legion: refused"
    },
    {
      "pattern": "connection-string-password",
      "name": "a quoted password with a comma glued to its closing quote",
      "detail": "connect(host='db', password='hunter2', port=5432)",
      "want": "connect(host='db', password='***', port=5432)"
    },
    {
      "pattern": "connection-string-password",
      "name": "a quoted password holding an escaped quote",
