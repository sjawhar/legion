{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "askId": {
      "type": "string"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "header": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      }
    },
    "multiple": {
      "type": "boolean"
    },
    "custom": {
      "type": "boolean"
    }
  },
  "required": [
    "question"
  ],
  "additionalProperties": false
}
