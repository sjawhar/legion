apiVersion: v1
kind: Config
clusters:
- name: example-dispatch
  cluster:
    server: https://example-endpoint
    certificate-authority-data: ZXhhbXBsZS1jYQ==
contexts:
- name: example-dispatch
  context:
    cluster: example-dispatch
    user: example-dispatch
current-context: example-dispatch
users:
- name: example-dispatch
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: gke-gcloud-auth-plugin
      installHint: Install gke-gcloud-auth-plugin (gcloud components install gke-gcloud-auth-plugin)
      provideClusterInfo: true
      interactiveMode: Never
